{
  "name": "contest-center",
  "version": "0.6.4",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "setup": "tsx scripts/setup.ts",
    "db:generate": "pnpm --filter @contest-center/server db:generate",
    "db:migrate": "pnpm --filter @contest-center/server db:migrate",
    "seed": "pnpm --filter @contest-center/server seed",
    "bootstrap:admin": "pnpm --filter @contest-center/server bootstrap:admin",
    "typecheck": "pnpm -r typecheck && tsc -p tests/tsconfig.json",
    "build": "pnpm -r build",
    "docs:build": "node scripts/build-docs-site.mjs",
    "docs:dev": "node scripts/serve-docs-site.mjs",
    "docs:test": "node tests/docs-site.browser.mjs",
    "docs:verify": "node scripts/test-docs.mjs",
    "test": "vitest run",
    "test:integration": "tsx tests/integrations/business.ts",
    "test:e2e": "playwright test",
    "test:load": "tsx tests/integrations/load.ts",
    "test:mcp": "tsx tests/contracts/mcp.ts",
    "test:oj": "tsx tests/integrations/oj.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "test:auth": "tsx tests/integrations/auth.ts",
    "test:template-bugs": "tsx tests/integrations/template-bugs.ts",
    "test:feishu": "tsx tests/integrations/feishu.ts",
    "test:mail-failover": "tsx tests/integrations/mail-failover.ts",
    "test:overview": "tsx tests/integrations/overview.ts",
    "test:ui-features": "playwright test tests/e2e/platform-improvements.spec.ts",
    "test:accounts": "tsx tests/integrations/account-management.ts",
    "test:invitations": "tsx tests/integrations/invitations.ts",
    "test:mail": "tsx tests/integrations/mail-settings.ts",
    "fixtures:domjudge": "tsx scripts/prepare-domjudge.ts",
    "test:boundaries": "tsx tests/integrations/boundaries.ts",
    "test:deployment": "tsx tests/integrations/deployment.ts",
    "test:install": "pnpm test:install-cli && tsx tests/integrations/install.ts",
    "test:install-cli": "node --test tests/install-cli.test.mjs",
    "test:install-images": "node --test tests/install-images.test.mjs",
    "test:web-static": "node --test tests/web-static.test.mjs",
    "test:install-proxy": "tsx tests/integrations/install-proxy.ts",
    "test:full": "tsx tests/integrations/full-regression.ts",
    "test:file-race": "tsx tests/integrations/file-race.ts",
    "test:permissions": "tsx tests/integrations/permission-regressions.ts",
    "test:platform-features": "tsx tests/integrations/platform-features.ts",
    "test:release-features": "tsx tests/integrations/release-features.ts",
    "test:install-bootstrap": "node --test tests/install-bootstrap.test.mjs",
    "test:install-gateway": "tsx tests/integrations/install-gateway.ts",
    "test:install-interactive": "tsx tests/integrations/install-interactive.ts",
    "generate:client": "openapi-typescript docs/api/openapi.json -o apps/web/src/generated/api.d.ts",
    "package:hydro": "pnpm --dir plugins/hydro-contest-center pack --pack-destination ../../dist",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test:admissions": "tsx tests/integrations/admissions-batch.ts",
    "restore:public-url": "tsx scripts/restore-public-url.ts",
    "test:enhancements": "tsx tests/integrations/enhancements.ts",
    "test:oj-enhancements": "tsx tests/integrations/oj-enhancements.ts",
    "test:oj-recovery": "tsx tests/integrations/oj-recovery.ts",
    "test:bugs": "tsx tests/integrations/bug-regressions.ts",
    "test:activity-workflows": "tsx tests/integrations/activity-workflows.ts",
    "test:workflow-upgrade": "tsx tests/integrations/workflow-upgrade.ts",
    "test:security": "tsx tests/integrations/security-audit.ts",
    "test:audit-fixes": "tsx tests/integrations/audit-fixes.ts",
    "test:backup-security": "node --test tests/backup-security.test.mjs tests/backup-lifecycle.test.mjs",
    "audit:runtime": "node scripts/audit-runtime.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
