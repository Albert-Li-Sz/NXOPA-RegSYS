generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  pendingEmail String?
  username String @unique
  passwordHash String?
  name String
  kind String @default("STUDENT")
  personId String? @db.Uuid
  person PersonRecord? @relation(fields:[personId],references:[id])
  identityStatus String @default("UNSUBMITTED")
  avatarAttachmentId String? @db.Uuid
  deactivatedAt DateTime?
  bannedAt DateTime?
  banReason String @default("")
  previousEmailHash String?
  verified Boolean @default(false)
  isAdmin Boolean @default(false)
  isCoach Boolean @default(false)
  profile Json @default("{}")
  tags String[] @default([])
  version Int @default(1)
  createdAt DateTime @default(now())
  sessions Session[]
  roles RoleAssignment[]
  grants AdminGrant[]
  identityRequests IdentityRequest[]
  identities ExternalIdentity[]
  coachedRegistrations RegistrationCoach[]
  @@index([tags], type: Gin)
  @@index([personId])
}
model PersonRecord {
  id String @id @default(uuid()) @db.Uuid
  identityKey String @unique
  kind String
  identifier String
  institution String
  data Json
  createdAt DateTime @default(now())
  users User[]
}
model IdentityRequest {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id])
  data Json
  status String @default("PENDING")
  reason String @default("")
  reviewedBy String? @db.Uuid
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  @@index([userId,status])
}
model AdminGrant {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id])
  level String
  contestId String? @db.Uuid
  permissions String[] @default([])
  grantedBy String @db.Uuid
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,revokedAt,expiresAt])
  @@index([contestId])
}
model Session {
  id String @id
  userId String @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  authenticatedAt DateTime @default(now())
  reauthenticatedAt DateTime?
  userAgent String
  @@index([userId])
}
model EmailToken {
  id String @id
  userId String @db.Uuid
  purpose String
  expiresAt DateTime
  usedAt DateTime?
  codeHash String?
  attempts Int @default(0)
  @@index([userId,purpose])
}
model RegistrationVerification {
  id String @id
  email String
  codeHash String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([email,usedAt])
}
model RoleAssignment {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  contestId String @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  contest Contest @relation(fields:[contestId],references:[id], onDelete:Cascade)
  @@unique([userId,contestId])
}
model Setting {
  key String @id
  value Json
  version Int @default(1)
}
/// GitHub login uses the github slug; other historical providers remain inactive.
model OAuthProvider {
  id String @id @default(uuid()) @db.Uuid
  slug String? @unique
  name String
  mode String
  issuer String?
  authorizationUrl String?
  tokenUrl String?
  userinfoUrl String?
  clientId String
  clientSecret String
  tokenAuthMethod String @default("client_secret_post")
  scopes String @default("openid email profile")
  subjectField String @default("sub")
  emailField String @default("email")
  verifiedField String @default("email_verified")
  nameField String @default("name")
  enabled Boolean @default(true)
  version Int @default(1)
  identities ExternalIdentity[]
}
model ExternalIdentity {
  id String @id @default(uuid()) @db.Uuid
  providerId String @db.Uuid
  subject String
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  provider OAuthProvider @relation(fields:[providerId],references:[id],onDelete:Cascade)
  @@unique([providerId,subject])
}
model Contest {
  kind String @default("COMPETITION")
  modules Json @default("{\"admissions\":true,\"rooms\":false}")
  accountSettings Json @default("{\"enabled\":false,\"prefix\":\"\",\"showOnAdmission\":true}")
  seatingMode String @default("REGISTRATION")
  seatingVersion Int @default(1)
  deletedSubmittedCount Int @default(0)
  deletedCancelledCount Int @default(0)
  id String @id @default(uuid()) @db.Uuid
  title String
  season String
  description String
  descriptionFormat String @default("TEXT")
  announcement String @default("")
  location String @default("")
  startsAt DateTime
  opensAt DateTime
  closesAt DateTime
  correctionUntil DateTime?
  published Boolean @default(false)
  archived Boolean @default(false)
  manuallyClosed Boolean @default(false)
  publicRosterEnabled Boolean @default(false)
  publicRosterReviews String[] @default(["APPROVED"])
  policy Json
  version Int @default(1)
  formVersion Int @default(1)
  nextRegistrationNumber Int @default(1)
  createdAt DateTime @default(now())
  roles RoleAssignment[]
  forms FormVersion[]
  registrations Registration[]
  rooms ExamRoom[]
  examSites ExamSite[]
  financeAccounts FinanceAccount[]
  @@index([published,archived,opensAt,closesAt])
}
model FieldDefinition {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  definition Json
  version Int @default(1)
}
model FormVersion {
  id String @id @default(uuid()) @db.Uuid
  contestId String @db.Uuid
  contest Contest @relation(fields:[contestId],references:[id],onDelete:Cascade)
  version Int
  fields Json
  schema Json
  createdAt DateTime @default(now())
  @@unique([contestId,version])
}
model Registration {
  id String @id @default(uuid()) @db.Uuid
  contestId String @db.Uuid
  contest Contest @relation(fields:[contestId],references:[id])
  ownerId String @db.Uuid
  number Int?
  publicRank Int?
  teamName String @default("")
  teamEnglishName String @default("")
  participationType String @default("OFFICIAL")
  organization Json?
  examSiteId String? @db.Uuid
  examSite ExamSite? @relation(fields:[examSiteId],references:[id],onDelete:Restrict)
  answers Json @default("{}")
  status String @default("DRAFT")
  review String @default("PENDING")
  reviewReason String @default("")
  formVersion Int
  snapshot Json?
  policySnapshot Json?
  feeCents Int @default(0)
  netPaidCents Int @default(0)
  quoted Boolean @default(false)
  eligible Boolean @default(false)
  version Int @default(1)
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  people RegistrationPerson[]
  coaches RegistrationCoach[]
  revisions RegistrationRevision[]
  seats SeatAssignment[]
  admissions AdmissionDocument[]
  competitionAccount CompetitionAccount?
  @@index([contestId,status,review,eligible])
  @@index([ownerId])
  @@index([examSiteId])
  @@index([contestId,createdAt,id])
  @@unique([contestId,number])
  teamFiles TeamFile[]
}
/// active_contest_user and active_contest_identifier are partial unique indexes maintained by SQL migrations. Never use db push.
model RegistrationPerson {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  registration Registration @relation(fields:[registrationId],references:[id],onDelete:Cascade)
  contestId String @db.Uuid
  userId String? @db.Uuid
  active Boolean @default(true)
  uniqueKey String?
  name String
  email String @default("")
  captain Boolean @default(false)
  confirmed Boolean @default(false)
  answers Json @default("{}")
  @@index([userId,active])
  @@index([registrationId])
}
model RegistrationCoach {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  registration Registration @relation(fields:[registrationId],references:[id],onDelete:Cascade)
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id])
  answers Json @default("{}")
  @@unique([registrationId,userId])
}
model Invitation {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  kind String
  registrationId String? @db.Uuid
  inviterId String @db.Uuid
  targetEmail String?
  targetUserId String? @db.Uuid
  contestId String? @db.Uuid
  coachId String? @db.Uuid
  expiresAt DateTime
  acceptedBy String? @db.Uuid
  acceptedAt DateTime?
  revoked Boolean @default(false)
  createdAt DateTime @default(now())
  grantExpiresAt DateTime?
  permissions String[] @default([])
  @@index([kind,createdAt])
  @@index([inviterId])
}
model RegistrationRevision {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  registration Registration @relation(fields:[registrationId],references:[id],onDelete:Cascade)
  version Int
  actorId String @db.Uuid
  snapshot Json
  reason String
  createdAt DateTime @default(now())
  @@unique([registrationId,version])
}
model Attachment {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  registrationId String? @db.Uuid
  ticketId String? @db.Uuid
  contestId String? @db.Uuid
  purpose String @default("PRIVATE")
  public Boolean @default(false)
  deletedAt DateTime?
  purgedAt DateTime?
  name String
  mime String
  size Int
  storageKey String @unique
  storageBackend String @default("LOCAL")
  storageConfigId String? @db.Uuid
  sha256 String @default("")
  teamFiles TeamFile[]
  createdAt DateTime @default(now())
  @@index([ownerId,deletedAt])
  @@index([ownerId,purgedAt])
  @@index([contestId,purpose])
  @@index([registrationId])
}
model TeamFile {
  id String @id @default(uuid()) @db.Uuid
  attachmentId String @db.Uuid
  attachment Attachment @relation(fields:[attachmentId],references:[id])
  registrationId String @db.Uuid
  assignedBy String @db.Uuid
  createdAt DateTime @default(now())
  @@unique([attachmentId,registrationId])
  @@index([registrationId])
  registration Registration @relation(fields:[registrationId],references:[id],onDelete:Cascade)
}
model StorageConfiguration {
  id String @id @default(uuid()) @db.Uuid
  name String
  endpoint String
  region String
  bucket String
  prefix String @default("nxopa")
  accessKey String
  encryptedSecret String
  forcePathStyle Boolean @default(true)
  createBucket Boolean @default(false)
  createdAt DateTime @default(now())
}
model MailTemplate {
  key String @id
  subject String
  text String
  html String
  enabled Boolean @default(true)
  version Int @default(1)
}
model PaymentVoucher {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  account FinanceAccount @relation(fields:[registrationId],references:[id])
  amountCents Int
  channel String
  reference String?
  payer String
  paidAt DateTime
  attachmentId String @db.Uuid
  status String @default("PENDING")
  reason String @default("")
  confirmedBy String? @db.Uuid
  createdBy String? @db.Uuid
  proofClaim PaymentProofClaim?
  createdAt DateTime @default(now())
  @@index([registrationId])
}
model PaymentProofClaim {
  attachmentId String @id @db.Uuid
  voucherId String @unique @db.Uuid
  voucher PaymentVoucher @relation(fields:[voucherId],references:[id],onDelete:Cascade)
  registrationId String? @db.Uuid
  proofSha256 String?
  @@unique([registrationId,proofSha256])
}
model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  account FinanceAccount @relation(fields:[registrationId],references:[id])
  contestId String @db.Uuid
  kind String
  amountCents Int
  sourceId String @unique
  channelReference String?
  normalizedReference String?
  requiresReconciliation Boolean @default(false)
  actorId String @db.Uuid
  note String
  createdAt DateTime @default(now())
  @@unique([contestId,channelReference])
  @@unique([contestId,normalizedReference])
  @@index([registrationId])
}
model Refund {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  account FinanceAccount @relation(fields:[registrationId],references:[id])
  amountCents Int
  reason String
  status String @default("REQUESTED")
  reference String?
  attachmentId String? @db.Uuid
  handledBy String? @db.Uuid
  requestedBy String? @db.Uuid
  approvedBy String? @db.Uuid
  secondReviewerId String? @db.Uuid
  rejectionReason String @default("")
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([registrationId])
}
model InvoiceRequest {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  account FinanceAccount @relation(fields:[registrationId],references:[id])
  amountCents Int
  title String
  taxId String
  email String
  invoiceType String?
  titleType String?
  contactName String?
  phone String?
  address String?
  bankName String?
  bankAccount String?
  remarks String?
  snapshot Json?
  status String @default("REQUESTED")
  attachmentId String? @db.Uuid
  handledBy String? @db.Uuid
  requestedBy String? @db.Uuid
  reason String @default("")
  createdAt DateTime @default(now())
  @@index([registrationId])
}
model SupportTicket {
  id String @id @default(uuid()) @db.Uuid
  contestId String? @db.Uuid
  registrationId String? @db.Uuid
  ownerId String @db.Uuid
  title String
  category String
  status String @default("OPEN")
  version Int @default(1)
  emailNotifications Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages SupportMessage[]
  @@index([createdAt,id])
  @@index([ownerId])
  @@index([contestId])
}
model SupportMessage {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  ticket SupportTicket @relation(fields:[ticketId],references:[id],onDelete:Cascade)
  actorId String @db.Uuid
  text String
  attachments Json @default("[]")
  createdAt DateTime @default(now())
}
model AdmissionTemplate {
  id String @id @default(uuid()) @db.Uuid
  contestId String? @db.Uuid
  name String
  source String
  version Int
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@index([contestId,active])
}
model AdmissionDocument {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  registration Registration @relation(fields:[registrationId],references:[id])
  number String @unique
  location String
  room String @default("")
  seat String @default("")
  registrationVersion Int
  templateId String @db.Uuid
  templateVersion Int
  version Int @default(1)
  state String @default("QUEUED")
  storageKey String?
  storageBackend String @default("LOCAL")
  storageConfigId String? @db.Uuid
  sha256 String @default("")
  error String?
  releasedAt DateTime?
  releaseAt DateTime?
  createdAt DateTime @default(now())
  @@unique([registrationId,registrationVersion,templateId])
}
model Job {
  id String @id @default(uuid()) @db.Uuid
  kind String
  resourceId String
  dedupeKey String @unique
  payload Json
  state String @default("PENDING")
  attempts Int @default(0)
  leaseToken String? @db.Uuid
  leaseUntil DateTime?
  error String?
  result Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([state,updatedAt])
  @@index([state,leaseUntil])
  @@index([createdAt,id])
  @@index([kind,resourceId,createdAt])
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  type String
  resourceId String
  payload Json
  deliveredAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime?
  createdAt DateTime @default(now())
  @@index([deliveredAt,createdAt])
  @@index([deliveredAt,nextAttemptAt,createdAt])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String
  action String
  resourceId String
  details Json
  createdAt DateTime @default(now())
  @@index([resourceId,createdAt])
  @@index([createdAt,id])
}
model IdempotencyRecord {
  resourceType String?
  resourceId String?
  id String @id
  @@index([resourceId])
  requestHash String
  result Json
  createdAt DateTime @default(now())
  @@index([createdAt])
}

/// The id stays equal to the source registration id so existing finance links remain valid.
model FinanceAccount {
  id String @id @db.Uuid
  contestId String @db.Uuid
  contest Contest @relation(fields:[contestId],references:[id])
  ownerId String @db.Uuid
  number Int?
  feeCents Int @default(0)
  netPaidCents Int @default(0)
  reconciliationRequired Boolean @default(false)
  policySnapshot Json
  cancelledAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  vouchers PaymentVoucher[]
  ledger LedgerEntry[]
  refunds Refund[]
  invoices InvoiceRequest[]
  @@index([ownerId,cancelledAt])
  @@index([contestId,createdAt,id])
}
model ExamSite {
  id String @id @default(uuid()) @db.Uuid
  contestId String @db.Uuid
  contest Contest @relation(fields:[contestId],references:[id],onDelete:Cascade)
  name String
  address String @default("")
  enabled Boolean @default(true)
  sortOrder Int @default(0)
  registrations Registration[]
  rooms ExamRoom[]
  @@index([contestId,sortOrder])
}
/// Positive capacity CHECK is maintained by SQL migrations and verified in CI.
model ExamRoom {
  id String @id @default(uuid()) @db.Uuid
  contestId String @db.Uuid
  contest Contest @relation(fields:[contestId],references:[id],onDelete:Cascade)
  name String
  code String?
  location String @default("")
  examSiteId String? @db.Uuid
  examSite ExamSite? @relation(fields:[examSiteId],references:[id],onDelete:Restrict)
  capacity Int
  sortOrder Int @default(0)
  enabled Boolean @default(true)
  version Int @default(1)
  seats SeatAssignment[]
  @@unique([contestId,name])
  @@unique([contestId,code])
  @@index([examSiteId])
}
/// Positive seat CHECK is maintained by SQL migrations and verified in CI.
model SeatAssignment {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  registration Registration @relation(fields:[registrationId],references:[id],onDelete:Cascade)
  roomId String @db.Uuid
  room ExamRoom @relation(fields:[roomId],references:[id])
  unitKey String
  personId String? @db.Uuid
  seat Int
  @@unique([roomId,seat])
  @@unique([registrationId,unitKey])
}

model CompetitionAccount {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @unique @db.Uuid
  registration Registration @relation(fields:[registrationId],references:[id],onDelete:Cascade)
  contestId String @db.Uuid
  username String
  credential String
  createdAt DateTime @default(now())
  @@unique([contestId,username])
}
model AdmissionBatch {
  id String @id @default(uuid()) @db.Uuid
  contestId String @db.Uuid
  actorId String @db.Uuid
  action String
  targets Json
  options Json @default("{}")
  state String @default("PREVIEW")
  result Json @default("{}")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([contestId,createdAt])
  @@index([expiresAt])
}
