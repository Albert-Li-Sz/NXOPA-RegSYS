# Place inside nginx's http context (e.g. /etc/nginx/conf.d/nxopa-regsys.conf).
# Configure DNS and certificates yourself; set PUBLIC_URL=https://reg.example.org.
server {
    listen 80;
    server_name reg.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name reg.example.org;
    ssl_certificate /etc/nginx/certs/reg.example.org/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/reg.example.org/privkey.pem;

    # Allow a 50 MiB file plus multipart form headers.
    client_max_body_size 60m;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_read_timeout 120s;

    location / {
        # Caddy routes /api/ internally. No trailing slash: preserve the request URI.
        proxy_pass http://127.0.0.1:8080;
    }
}
