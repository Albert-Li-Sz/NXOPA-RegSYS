# Docker Compose 项目名决定容器和数据卷前缀，部署后保持不变。
COMPOSE_PROJECT_NAME=nxopa-regsys

# source 从源码构建；images 拉取 GitHub Release 对应的预构建镜像。
INSTALL_MODE=source
IMAGE_PREFIX=ghcr.io/albert-li-sz/nxopa-regsys
IMAGE_TAG=v0.6.3

# 内部 Caddy 合并前端和 API，只提供 HTTP；自有反向代理负责公网 HTTPS。
# PUBLIC_URL 是浏览器访问地址，GATEWAY_PORT 仅绑定本机。
PUBLIC_URL=http://localhost:8080
REVERSE_PROXY_MODE=gateway
GATEWAY_PORT=8080
GATEWAY_BIND_ADDRESS=127.0.0.1

# 兼容 v0.1.4 的双上游部署：显式设 REVERSE_PROXY_MODE=external 时使用。
# WEB_PORT=8081
# API_PORT=3000

# bash install.sh init 自动生成；已有 .env 不会覆盖或重新生成密钥。
POSTGRES_PASSWORD=GENERATE_ON_INSTALL
ENCRYPTION_KEY=GENERATE_ON_INSTALL

# GitHub 加速前缀，下载 Release 附件时拼接到完整 URL 前；留空直连。
NXOPA_GITHUB_PREFIX=

# 新安装默认内置 MinIO。已有旧配置缺少此项时仍使用 LOCAL。
STORAGE_MODE=MINIO
MINIO_ROOT_USER=GENERATE_ON_INSTALL
MINIO_ROOT_PASSWORD=GENERATE_ON_INSTALL
MINIO_CONSOLE_PORT=9001
MINIO_BIND_ADDRESS=127.0.0.1
# 使用第三方 S3 时填写；也可在“管理中心 → 文件存储”中配置。
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=nxopa-regsys
S3_PREFIX=nxopa
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# 首次登录后在“管理中心 → 邮件设置”配置 SMTP。
# 如需使用环境初始值，取消注释并填写真实配置。
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURITY=STARTTLS
# SMTP_USER=noreply@example.org
# SMTP_PASSWORD=邮箱授权码
# SMTP_FROM=南晓开放原子社在线报名系统 <noreply@example.org>

# 默认允许内网 Hydro / DOMjudge；如需禁用，显式设置为 false。
ALLOW_PRIVATE_INTEGRATIONS=true
# Webhook 的单个内网地址须在后台由系统管理员另行批准。
# 可选额外浏览器来源，逗号分隔，不含路径；同源与当前公网地址自动允许。
TRUSTED_MANAGEMENT_ORIGINS=
# 单个账号累计上传配额（MB）；默认普通账号 1024，管理员 10240。
# UPLOAD_QUOTA_MB=1024

# GitHub OAuth App，可在管理中心配置；留空时 GitHub 登录保持关闭。
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=

# 飞书应用，可在“管理中心 → 飞书登录”配置；留空时飞书登录保持关闭。
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_CALLBACK_URL=
