NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgresql://contest:contest_local_only@localhost:55432/contest_center
REDIS_URL=redis://localhost:56379
STORAGE_DIR=../../.runtime/storage
LATEX_SPOOL=../../.runtime/latex
ENCRYPTION_KEY=GENERATE_WITH_PNPM_SETUP
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_FROM=南晓开放原子社在线报名系统 <noreply@example.test>
# 邮件初始值；管理中心保存后优先使用数据库配置，无需重启。
# SMTP_SECURITY=TLS / STARTTLS / NONE
SITE_ADDRESS=:80
POSTGRES_PASSWORD=contest_local_only
ALLOW_PRIVATE_INTEGRATIONS=true
# 可选额外浏览器写入来源，逗号分隔；同源与当前公网地址自动允许。
TRUSTED_MANAGEMENT_ORIGINS=
# 单个账号的累计上传配额（MB）；未设置时普通账号 1024，管理员 10240。
# UPLOAD_QUOTA_MB=1024
# 可在管理中心配置飞书登录；环境配置仅作为初始值。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CALLBACK_URL=
